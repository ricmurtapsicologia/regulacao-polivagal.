          "duration_seconds": 6.8,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 1,
          "text": "Perceba três pontos de contato do corpo.",
          "url": "./audio/n3/orientar-02.mp3?v=n3-20260831",
          "duration_seconds": 6.2,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 2,
          "text": "Identifique três sons.",
          "url": "./audio/n3/orientar-03.mp3?v=n3-20260831",
          "duration_seconds": 5.3,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 3,
          "text": "Observe um objeto neutro.",
          "url": "./audio/n3/orientar-04.mp3?v=n3-20260831",
          "duration_seconds": 5.4,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 4,
          "text": "Pergunte: qual é o próximo passo pequeno e seguro?",
          "url": "./audio/n3/orientar-05.mp3?v=n3-20260831",
          "duration_seconds": 6.4,
          "intents": [
            "question"
          ],
          "turns": 1
        }
      ]
    },
    "pressao": {
      "title": "Pressão e apoio corporal",
      "steps": [
        {
          "index": 0,
          "text": "Apoie os pés e perceba a pressão.",
          "url": "./audio/n3/pressao-01.mp3?v=n3-20260831",
          "duration_seconds": 6.3,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 1,
          "text": "Pressione levemente os pés e solte.",
          "url": "./audio/n3/pressao-02.mp3?v=n3-20260831",
          "duration_seconds": 6.6,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 2,
          "text": "Una as palmas das mãos e solte.",
          "url": "./audio/n3/pressao-03.mp3?v=n3-20260831",
          "duration_seconds": 6.0,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 3,
          "text": "Perceba costas, quadris ou braços sendo sustentados.",
          "url": "./audio/n3/pressao-04.mp3?v=n3-20260831",
          "duration_seconds": 8.2,
          "intents": [
            "instruction"
          ],
          "turns": 1
        }
      ]
    },
    "movimento": {
      "title": "Movimento pequeno e orientado",
      "steps": [
        {
          "index": 0,
          "text": "Mova lentamente os dedos.",
