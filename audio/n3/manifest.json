        {
          "index": 3,
          "text": "Olhe ao redor e nomeie onde está.",
          "url": "./audio/n3/temperatura-04.mp3?v=n3-20260831",
          "duration_seconds": 6.5,
          "intents": [
            "instruction"
          ],
          "turns": 1
        }
      ]
    },
    "onda": {
      "title": "Observar a urgência como uma onda",
      "steps": [
        {
          "index": 0,
          "text": "Onde a urgência aparece no corpo?",
          "url": "./audio/n3/onda-01.mp3?v=n3-20260831",
          "duration_seconds": 4.9,
          "intents": [
            "question"
          ],
          "turns": 1
        },
        {
          "index": 1,
          "text": "Dê uma nota mental de intensidade.",
          "url": "./audio/n3/onda-02.mp3?v=n3-20260831",
          "duration_seconds": 4.7,
          "intents": [
            "explain"
          ],
          "turns": 1
        },
        {
          "index": 2,
          "text": "Perceba se cresce, diminui ou muda.",
          "url": "./audio/n3/onda-03.mp3?v=n3-20260831",
          "duration_seconds": 6.8,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 3,
          "text": "Diga: “Uma urgência não é uma ordem.”",
          "url": "./audio/n3/onda-04.mp3?v=n3-20260831",
          "duration_seconds": 5.3,
          "intents": [
            "explain"
          ],
          "turns": 1
        },
        {
          "index": 4,
          "text": "Escolha não agir por mais alguns minutos.",
          "url": "./audio/n3/onda-05.mp3?v=n3-20260831",
          "duration_seconds": 6.1,
          "intents": [
            "instruction"
          ],
          "turns": 1
        }
      ]
    },
    "desfusao": {
      "title": "Nomear sem discutir com a mente",
      "steps": [
        {
          "index": 0,
          "text": "Note: “Minha mente está dizendo que preciso resolver isso agora.”",
