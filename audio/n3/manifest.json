          "duration_seconds": 7.3,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 3,
          "text": "Pergunte qual ação segura escolheria sem obedecer ao pensamento.",
          "url": "./audio/n3/desfusao-04.mp3?v=n3-20260831",
          "duration_seconds": 7.6,
          "intents": [
            "instruction"
          ],
          "turns": 1
        }
      ]
    },
    "valores": {
