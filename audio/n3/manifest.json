    "stop": {
      "title": "STOP — não agir no automático",
      "steps": [
        {
          "index": 0,
          "text": "Pare. Não envie, responda ou decida ainda.",
          "url": "./audio/n3/stop-01.mp3?v=n3-20260831",
          "duration_seconds": 7.7,
          "intents": [
            "explain"
          ],
          "turns": 2
        },
        {
          "index": 1,
          "text": "Perceba os pontos de apoio do corpo.",
          "url": "./audio/n3/stop-02.mp3?v=n3-20260831",
          "duration_seconds": 6.7,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 2,
          "text": "Observe: o que sinto, penso e quero fazer?",
          "url": "./audio/n3/stop-03.mp3?v=n3-20260831",
          "duration_seconds": 6.2,
          "intents": [
            "question"
          ],
          "turns": 1
        },
        {
          "index": 3,
          "text": "Escolha só o próximo passo seguro e reversível.",
          "url": "./audio/n3/stop-04.mp3?v=n3-20260831",
          "duration_seconds": 6.8,
          "intents": [
            "instruction"
          ],
          "turns": 1
        }
      ]
    },
    "adiar": {
      "title": "Adiar decisão importante",
      "steps": [
        {
          "index": 0,
          "text": "Diga: “Posso reavaliar isso depois.”",
          "url": "./audio/n3/adiar-01.mp3?v=n3-20260831",
          "duration_seconds": 5.1,
          "intents": [
            "explain"
          ],
          "turns": 1
        },
        {
          "index": 1,
          "text": "Liste o que não precisa ser decidido agora.",
          "url": "./audio/n3/adiar-02.mp3?v=n3-20260831",
          "duration_seconds": 4.9,
          "intents": [
            "explain"
          ],
          "turns": 1
        },
        {
          "index": 2,
          "text": "Escolha uma ação neutra e reversível.",
          "url": "./audio/n3/adiar-03.mp3?v=n3-20260831",
          "duration_seconds": 5.8,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 3,
          "text": "Defina um momento posterior para reavaliar.",
          "url": "./audio/n3/adiar-04.mp3?v=n3-20260831",
          "duration_seconds": 5.3,
          "intents": [
            "explain"
          ],
          "turns": 1
        }
      ]
    },
    "exalar": {
      "title": "Expiração suavemente mais longa",
      "steps": [
        {
          "index": 0,
          "text": "Solte os ombros e note a respiração.",
          "url": "./audio/n3/exalar-01.mp3?v=n3-20260831",
          "duration_seconds": 7.1,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 1,
          "text": "Inspire leve por 4 tempos.",
          "url": "./audio/n3/exalar-02.mp3?v=n3-20260831",
          "duration_seconds": 6.2,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 2,
          "text": "Expire confortável por 6 tempos.",
          "url": "./audio/n3/exalar-03.mp3?v=n3-20260831",
          "duration_seconds": 5.7,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 3,
          "text": "Repita sem forçar.",
          "url": "./audio/n3/exalar-04.mp3?v=n3-20260831",
          "duration_seconds": 5.1,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 4,
          "text": "Volte à respiração espontânea e olhe ao redor.",
          "url": "./audio/n3/exalar-05.mp3?v=n3-20260831",
          "duration_seconds": 6.8,
          "intents": [
            "instruction"
          ],
          "turns": 1
        }
      ]
    },
    "orientar": {
      "title": "Orientação pelos sentidos",
      "steps": [
        {
          "index": 0,
          "text": "Olhe três objetos e note suas cores.",
