          "duration_seconds": 6.8,
          "intents": [
            "instruction"
          ],
          "turns": 1
        },
        {
          "index": 4,
          "text": "Escolha uma ação simples: água, postura ou proximidade.",
          "url": "./audio/n3/movimento-05.mp3?v=n3-20260831",
          "duration_seconds": 8.3,
          "intents": [
            "instruction"
          ],
          "turns": 1
        }
      ]
    },
    "temperatura": {
      "title": "Temperatura confortável",
      "steps": [
        {
          "index": 0,
          "text": "Segure um objeto fresco ou morno.",
